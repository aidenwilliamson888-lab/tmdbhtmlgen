                        <!-- Link dengan target="_self" (tab yang sama) -->
                        <a href="${link1Url}" class="link-btn" target="_self" rel="nofollow"><i class="fas fa-play-circle"></i> ${link1Text}</a>
                        <a href="${link2Url}" class="link-btn" style="background:#1d3a3a;" target="_self" rel="nofollow"><i class="fas fa-download"></i> ${link2Text}</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- TRAILER SECTION -->
        ${trailerKey ? `
        <h2 style="margin-bottom: 1rem;"><i class="fab fa-youtube" style="color:#ff0000;"></i> Official Trailer</h2>
        <div class="trailer-container">
            <iframe src="https://www.youtube.com/embed/${trailerKey}?rel=0&modestbranding=1" 
                    title="${movie.title} trailer" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen
                    loading="lazy">
            </iframe>
        </div>
        ` : backdropUrl ? `
        <h2 style="margin-bottom: 1rem;"><i class="fas fa-image"></i> Featured Scene</h2>
        <div style="aspect-ratio: 16/9; border-radius: 1.5rem; overflow: hidden; background-image: url('${backdropUrl}'); background-size: cover; background-position: center; margin: 2rem 0;">
            <div style="width: 100%; height: 100%; background: linear-gradient(0deg, rgba(0,0,0,0.5) 0%, transparent 100%); display: flex; align-items: flex-end; padding: 2rem;">
                <h3 style="color: white;">${movie.title}</h3>
            </div>
        </div>
        ` : ''}

        <!-- ARTIKEL SEO 1 -->
        <div class="article">
            <h2>${texts.storyTitle.replace(/{title}/g, movie.title)}</h2>
            <div class="article-meta"><i class="far fa-clock"></i> 15 min read · updated ${year}</div>
            <p>${movie.overview || 'The film brings new adventures and stunning visual effects.'} ${texts.intro}</p>
            <div class="article-quote">${texts.quote.replace(/{title}/g, movie.title)}</div>
            <p>${texts.psychology}</p>
        </div>

        <!-- ARTIKEL SEO 2 -->
        <div class="article">
            <h2>${texts.watchTitle.replace(/{title}/g, movie.title)}</h2>
            <div class="article-meta"><i class="fas fa-tag"></i> Legal sources · 4K UHD</div>
            <p>${texts.streaming.replace(/{title}/g, movie.title)}</p>
            <ul style="margin: 1rem 0 0 2rem; color: #cbd5e1;">
                <li>Disney+ Hotstar (expected release)</li>
                <li>Netflix (regional availability)</li>
                <li>Amazon Prime Video (rental/purchase)</li>
                <li>Local streaming providers in your country</li>
            </ul>
        </div>

        <!-- ARTIKEL SEO 3 -->
        <div class="article">
            <h2>${texts.whyTitle.replace(/{title}/g, movie.title)}</h2>
            <div class="article-meta"><i class="fas fa-chart-line"></i> Analysis · new characters</div>
            <p>${texts.analysis}</p>
            <div class="article-quote">${texts.impact.replace(/{title}/g, movie.title)}</div>
        </div>

        <!-- REKOMENDASI -->
        ${recommendations.length ? `
        <h3 style="margin: 2rem 0 1rem;"><i class="fas fa-thumbs-up"></i> You may also like</h3>
        <div class="rec-grid">
            ${recommendations.map(m => `
                <div class="rec-item">
                    ${m.poster_path ? `<img src="${IMG_BASE}${m.poster_path}" alt="${m.title}" loading="lazy">` : '<div style="background:#1a2440; padding:1.5rem; text-align:center;"><i class="fas fa-image fa-2x"></i></div>'}
                    <div class="rec-title">${m.title}</div>
                </div>
            `).join('')}
        </div>
        ` : ''}

        <div class="footer">
            <i class="fas fa-crown"></i> All rights reserved ID ${movieId} · 2026
        </div>
    </div>
</body>
</html>`;
        return { html, title: movie.title, movieId, overview: movie.overview, slug };
    }

    // ========== BULK GENERATE ==========
    async function bulkGenerate() {
        if (isGenerating) { log('⏳ Masih dalam proses...', 'error'); return; }

        const apiKey = apiKeyInput.value.trim() || DEFAULT_API;
        const lang = bulkLang.value;
        const link1Text = bulkLink1Text.value.trim() || '▶ Watch';
        const link2Text = bulkLink2Text.value.trim() || '⬇️ Download';
        const baseLink = baseLinkInput.value.trim();
        const titleTemplates = getTitleTemplates();
        
        const idsText = movieIdsTextarea.value.trim();
        const idMatches = idsText.split(/\r?\n/)
            .map(line => line.trim())
            .filter(line => line && /^\d+$/.test(line));
            
        if (!idMatches?.length) { log('❌ Tidak ada ID valid', 'error'); return; }

        const uniqueIds = [...new Set(idMatches)];
        totalCountSpan.innerText = uniqueIds.length;
        generatedCountSpan.innerText = '0';
        progressPercent.innerText = '0%';
        progressFill.style.width = '0%';
        generatedFiles = [];
        updateFilePreview();

        log(`🚀 Generate ${uniqueIds.length} file dengan link button ke ID (self target)...`);
        isGenerating = true;
        downloadBtn.disabled = true;
        downloadRssBtn.disabled = true;
        downloadUrlsBtn.disabled = true;

        let successCount = 0;
        for (let i = 0; i < uniqueIds.length; i++) {
            const movieId = uniqueIds[i];
            log(`⏳ [${i+1}/${uniqueIds.length}] ID ${movieId}...`);

            const result = await generateMovieHTML(apiKey, movieId, lang, link1Text, link2Text, titleTemplates, baseLink);
            
            if (result) {
                generatedFiles.push({
                    filename: result.slug,
                    content: result.html,
                    movieId,
                    title: result.title,
                    overview: result.overview,
                    slug: result.slug
                });
                successCount++;
                log(`✅ ID ${movieId} (${result.title}) -> ${result.slug}`, 'success');
            }

            const percent = Math.round(((i + 1) / uniqueIds.length) * 100);
            progressPercent.innerText = `${percent}%`;
            progressFill.style.width = `${percent}%`;
            generatedCountSpan.innerText = successCount;
            updateFilePreview();
        }

        log(`🎉 Selesai! ${successCount} file`, 'success');
        isGenerating = false;
        if (successCount > 0) {
            downloadBtn.disabled = false;
            downloadRssBtn.disabled = false;
            downloadUrlsBtn.disabled = false;
        }
    }

    function updateFilePreview() {
        previewCountSpan.innerText = generatedFiles.length;
        if (!generatedFiles.length) {
            filePreviewGrid.innerHTML = '<div style="color: #6b83b0; text-align: center; padding: 2rem; grid-column: 1/-1;"><i class="fas fa-folder-open" style="font-size: 3rem; opacity: 0.5; margin-bottom: 1rem;"></i><p>Belum ada file yang digenerate</p></div>';
            return;
        }
        
        filePreviewGrid.innerHTML = generatedFiles.map(f => `
            <div class="file-card">
                <div class="file-icon"><i class="fas fa-file-code"></i></div>
                <div class="file-info">
                    <div class="file-name">${f.filename.substring(0, 25)}...</div>
                    <div class="file-meta">${f.title.substring(0, 30)}</div>
                </div>
            </div>
        `).join('');
    }

    function downloadZip() {
        if (!generatedFiles.length) return;
        const zip = new JSZip();
        generatedFiles.forEach(f => zip.file(f.filename, f.content));
        zip.generateAsync({ type: 'blob' }).then(blob => {
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `tmdb_movies_${Date.now()}.zip`;
            link.click();
            log('📦 ZIP berhasil didownload', 'success');
        });
    }

    function downloadRss() {
        if (!generatedFiles.length) return;
        const rssContent = generateRssFeed(generatedFiles, bulkLang.value);
        const blob = new Blob([rssContent], { type: 'application/rss+xml' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'feed.xml';
        link.click();
        log('📡 RSS feed berhasil didownload', 'success');
    }

    function downloadUrls() {
        if (!generatedFiles.length) return;
        const baseLink = baseLinkInput.value.trim();
        if (!baseLink) {
            log('❌ Base link tidak diisi', 'error');
            return;
        }
        
        const urlsContent = generateUrlsTxt(generatedFiles, baseLink, bulkLang.value);
        const blob = new Blob([urlsContent], { type: 'text/plain' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'urls.txt';
        link.click();
        log('📄 URLs TXT berhasil didownload', 'success');
    }

    // ========== EVENT ==========
    generateBtn.addEventListener('click', bulkGenerate);
    downloadBtn.addEventListener('click', downloadZip);
    downloadRssBtn.addEventListener('click', downloadRss);
    downloadUrlsBtn.addEventListener('click', downloadUrls);
    clearLogsBtn.addEventListener('click', clearLogs);

    titleTemplatesArea.addEventListener('input', () => {
        const templates = getTitleTemplates();
        if (templates.length) {
            document.getElementById('templateExample').innerHTML = 
                `<i class="fas fa-eye"></i> Contoh: "${templates[0].replace(/{TITLE}/g, 'Avatar 3').substring(0, 60)}..."`;
        }
    });

    log('✅ FINAL VERSION · Auto Translate All Headers · Link Self Target');
})();
</script>
</body>
</html>
