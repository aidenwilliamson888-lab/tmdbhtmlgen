    function getTitleTemplates() {
        const text = titleTemplatesArea.value.trim();
        return text ? text.split('|').map(t => t.trim()).filter(t => t.length) : ['{TITLE} (2026) Watch Online'];
    }

    function getRandomTitle(templates, movieTitle) {
        if (!templates.length) return movieTitle;
        return templates[Math.floor(Math.random() * templates.length)].replace(/{TITLE}/g, movieTitle);
    }

    // Generate kode unik random (5-8 karakter)
    function generateUniqueCode() {
        const length = Math.floor(Math.random() * 4) + 5; // 5-8
        const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
        let result = '';
        for (let i = 0; i < length; i++) {
            result += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        return result;
    }

    // Create slug berdasarkan bahasa
    function createSlug(title, id, lang) {
        const uniqueCode = generateUniqueCode();
        
        // Jika bahasa non-latin, return {kodeunik}.html
        if (NON_LATIN_LANGS.includes(lang)) {
            return `${uniqueCode}.html`;
        }
        
        // Untuk bahasa latin: {kodeunik}-{title}.html
        const slugTitle = title
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');
        
        return `${uniqueCode}-${slugTitle}.html`;
    }

    // ========== IMPORT TXT ==========
    txtFileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        
        const reader = new FileReader();
        reader.onload = function(e) {
            const content = e.target.result;
            const ids = content.split(/\r?\n/)
                .map(line => line.trim())
                .filter(line => line && /^\d+$/.test(line));
            
            if (ids.length > 0) {
                movieIdsTextarea.value = ids.join('\n');
                log(`📄 Import ${ids.length} ID dari file ${file.name}`, 'success');
            } else {
                log('❌ Tidak ada ID valid dalam file', 'error');
            }
        };
        reader.readAsText(file);
    });

    // ========== FETCH TMDB LENGKAP ==========
    async function fetchMovieDetails(apiKey, movieId, language) {
        const url = `https://api.themoviedb.org/3/movie/${movieId}?api_key=${apiKey}&language=${language}&append_to_response=videos,images,recommendations`;
        try {
            const res = await fetch(url);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return await res.json();
        } catch (e) {
            log(`❌ Gagal fetch ID ${movieId}: ${e.message}`, 'error');
            return null;
        }
    }

    // ========== GENERATE RSS FEED ==========
    function generateRssFeed(movies, lang) {
        const now = new Date().toUTCString();
        const items = movies.map(m => {
            const slug = createSlug(m.title, m.movieId, lang);
            const url = `https://${DOMAIN}/${slug}`;
            const description = m.overview ? m.overview.substring(0, 200) : 'Watch online';
            
            return `
    <item>
        <title>${m.title}</title>
        <link>${url}</link>
        <guid isPermaLink="false">${slug}</guid>
        <pubDate>${now}</pubDate>
        <description>${description.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</description>
    </item>`;
        }).join('');

        return `<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
    <channel>
        <title>TMDB Movie Feed</title>
        <link>https://${DOMAIN}/</link>
        <description>Latest generated movies from TMDB</description>
        <language>en-us</language>
        <pubDate>${now}</pubDate>
        <lastBuildDate>${now}</lastBuildDate>
        <atom:link href="https://${DOMAIN}/feed.xml" rel="self" type="application/rss+xml"/>
        ${items}
    </channel>
</rss>`;
    }

